# Copy to .env for local dev. On Cloudflare Pages, set the same names
# under Settings → Environment variables (Production).

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — can also be pasted in Settings after deploy
# VITE_GOOGLE_CLIENT_ID=
# VITE_VAPID_PUBLIC_KEY=
# VITE_GIPHY_API_KEY=   # optional; falls back to Giphy’s public beta key
# VITE_GIPHY_USE_FUNCTION=1  # only after: supabase functions deploy giphy
