# Copy to .env for local dev. On Cloudflare Pages, set the same names
# under Settings → Environment variables (Production).

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Calendar (OAuth Web client ID). Also pasteable in Settings.
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# VITE_VAPID_PUBLIC_KEY=
# VITE_GIPHY_API_KEY=   # required for covers — free at developers.giphy.com
# VITE_GIPHY_USE_FUNCTION=1  # only after: supabase functions deploy giphy
